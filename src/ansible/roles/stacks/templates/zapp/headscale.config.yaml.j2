# Headscale configuration — managed by Ansible
# See: https://headscale.net/stable/setup/install/container/#configure-and-run-headscale
# Ref: https://raw.githubusercontent.com/juanfont/headscale/refs/heads/main/config-example.yaml

server_url: {{ headscale_server_url }}
listen_addr: 0.0.0.0:8080

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

database:
  type: sqlite
  gorm:
    prepare_stmt: true
    parameterized_queries: true
    skip_err_record_not_found: true
    slow_threshold: 1000
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

derp:
  server:
    enabled: true
    region_id: 900
    region_code: "zapp"
    region_name: "Zapp DERP"
    stun_listen_addr: "0.0.0.0:3478"
    verify_clients: true
    automatically_add_embedded_derp_region: true
    private_key_path: /var/lib/headscale/derp_server_private.key
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 3h

# TODO: Implement proper ACLs
policy:
  mode: file
  path: ""

dns:
  magic_dns: true
  base_domain: {{ headscale_base_domain }}
  override_local_dns: false
  nameservers:
    global:
{% for dns in public_dns_servers %}
      - {{ dns }}
{% endfor %}
{% if dns_node_tailscale_ip %}
    split:
      home:
        - {{ dns_node_tailscale_ip }}
{% else %}
    split: {}
{% endif %}
  search_domains:
    - home
  extra_records: []

logtail:
  enabled: false

randomize_client_port: false
